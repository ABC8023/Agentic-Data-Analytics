# Copy to .streamlit/secrets.toml (git-ignored) to turn on single sign-on
# through Streamlit's st.login. Any OpenID Connect provider works; this is
# the shape for Google. See auth.py for how the app uses it.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "generate-a-long-random-string"
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
