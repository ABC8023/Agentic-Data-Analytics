GOOGLE_API_KEY=your_gemini_api_key_here

# Alternative variable name, checked when GOOGLE_API_KEY is not set.
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional. The default, gemini-flash-latest, is a rolling alias: the model
# behind it can change between runs. Pin a dated model for evaluations.
# Each model has its own free-tier quota; gemini-3.5-flash-lite allows about
# 500 requests a day and scored 66/67 on the evaluation set.
# AI_ANALYST_MODEL=gemini-3.5-flash-lite

# Optional. Seconds before one request is abandoned, and retries after it.
# AI_ANALYST_LLM_TIMEOUT=60
# AI_ANALYST_LLM_MAX_RETRIES=2

# Optional. Reasoning tokens the model may spend per reply. Unset uses the
# provider default. 0 makes planning faster and cheaper; run the evaluation
# before and after to see what it costs in accuracy.
# AI_ANALYST_THINKING_BUDGET=0

# Optional. Embedding model for glossary retrieval. Unset means lexical
# (BM25) retrieval only, which sends nothing anywhere. Setting it sends the
# uploaded glossary's text to the provider to be embedded.
# AI_ANALYST_EMBEDDING_MODEL=<embedding-model-name>

# Optional. Append one JSON event per question to this file. Events carry
# route, outcome, latency and token counts, never data values.
# AI_ANALYST_EVENT_LOG=tools/results/events.jsonl
# Include the question text in events. Off by default: questions can
# contain personal data.
# AI_ANALYST_LOG_QUESTION_TEXT=1

# HTTP API (uvicorn api:app). Required: comma-separated keys. With none set,
# every /v1 request is refused.
# AI_ANALYST_API_KEYS=generate-a-long-random-key
# Requests per key per minute, per process. Default 30.
# AI_ANALYST_API_RATE_LIMIT=30
# Folder of datasets the API may read. Default sample_data.
# AI_ANALYST_API_DATA_DIR=sample_data
# Set to 0 to keep the API to the rules alone, with no model calls.
# AI_ANALYST_API_USE_MODEL=1

# Streamlit app sign-in. Off unless one of these is configured.
# For a real deployment, use single sign-on: add an [auth] section to
# .streamlit/secrets.toml (see .streamlit/secrets.toml.example).
# For a demo link, a shared password is enough:
# AI_ANALYST_APP_PASSWORD=choose-a-long-passphrase
# With single sign-on, restrict who gets in (addresses or @domains):
# AI_ANALYST_ALLOWED_EMAILS=@example.com,someone@example.org

# Shared rate limit for the API when it runs as more than one process.
# Unset keeps the limit in memory, which holds per process only.
# AI_ANALYST_REDIS_URL=redis://localhost:6379/0
